---
import {getCollection,render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import {site} from '../../lib/data';
export async function getStaticPaths(){return (await getCollection('projects',({data})=>data.visible)).map(project=>({params:{slug:project.id},props:{project}}));}
const {project}=Astro.props;
const {Content}=await render(project);
const p=project.data;
const related=(await getCollection('projects',({data})=>data.visible&&data.category===p.category)).filter(x=>x.id!==project.id).slice(0,2);
---
<Layout title={`${p.title} | Dineth Basura`} description={p.description}><article class="project-detail section-wrap"><a href="/#projects" class="text-link back-link">← Back to selected work</a><div class="section-label"><span>{p.category}</span>{p.date&&<span>{p.date}</span>}</div><h1>{p.title}</h1><p class="detail-intro">{p.description}</p><div class="detail-actions"><a class="button primary" href={p.repository} target="_blank" rel="noopener noreferrer">View source <Icon name="github" size={18}/></a>{p.demo&&<a class="button secondary" href={p.demo} target="_blank" rel="noopener noreferrer">Live demo <Icon name="arrow"/></a>}</div><div class:list={["detail-visual",{"has-cover":!!p.image}]}>{p.image?<img src={p.image} alt={p.imageAlt||p.title} width="512" height="341"/>:<ProjectVisual visual={p.visual} title={p.title} large/>}{(!p.image||p.imageType==='concept')&&<span class="concept-note">Conceptual artwork · not an application screenshot</span>}</div><div class="detail-layout"><aside class="detail-sidebar"><span class="mini-label">TECHNOLOGY STACK</span><ul>{p.technologies.map(t=><li>{t}</li>)}</ul>{p.additionalRepositories.length>0&&<><span class="mini-label">RELATED REPOSITORIES</span>{p.additionalRepositories.map((url,i)=><a class="text-link" href={url} target="_blank" rel="noopener noreferrer">Repository {i+1}<Icon name="arrow" size={15}/></a>)}</>}<a class="text-link" href={site.cv} download>Download CV <Icon name="download" size={15}/></a></aside><div class="prose"><Content/>{p.screenshots.length>0&&<section><h2>Screenshots</h2>{p.screenshots.map(s=><figure><a href={s.image} target="_blank" rel="noopener noreferrer"><img src={s.image} alt={s.alt} width="900" height="600" loading="lazy"/></a>{s.caption&&<figcaption>{s.caption}</figcaption>}</figure>)}</section>}</div></div>{related.length>0&&<div class="related-projects"><h2>Keep exploring.</h2>{related.map(r=><a href={`/projects/${r.id}/`}>{r.data.title}<Icon name="arrow"/></a>)}</div>}</article></Layout>
